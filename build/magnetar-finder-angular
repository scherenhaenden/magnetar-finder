set -euo pipefail

DEFAULT_PORT=7475
OPEN_BROWSER=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --port)       DEFAULT_PORT="$2"; shift 2 ;;
    --no-browser) OPEN_BROWSER=false; shift ;;
    *)            echo "Unknown arg: $1"; exit 1 ;;
  esac
done

# Find a free port
PORT=$DEFAULT_PORT
while python3 -c "import socket; s=socket.socket(); s.connect(('127.0.0.1',$PORT)); s.close()" 2>/dev/null; do
  ((PORT++))
done

